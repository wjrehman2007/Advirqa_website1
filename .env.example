# Use the exact origin visitors use. Set true for the approved public site.
SITE_URL=
SITE_INDEXABLE=false

# Server-only Resend credentials and a sender on a verified domain.
RESEND_API_KEY=
INQUIRY_EMAIL_FROM=

# Optional if site.email in lib/site-config.ts is populated.
INQUIRY_EMAIL_TO=

# Optional. Set only if your host overwrites this header with the visitor's IP.
INQUIRY_IP_HEADER=

# Optional Search Console ownership verification.
GOOGLE_SITE_VERIFICATION=

